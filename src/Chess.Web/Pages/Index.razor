@page "/"
@using Chess.Web.Components
@inject AppState State
@inject IGameHandler GameRunner

<PageTitle>Chess</PageTitle>

<main class="game">
	<div class="game__board">
		<ChessBoard />
	</div>

	<aside class="game__panel" aria-label="Game information">
		<GameStatusBar />
		<CapturedPieces />
		<MoveHistory />
	</aside>
</main>

@code {
	protected override void OnInitialized()
	{
		// The domain must be initialised before any move can be played: until
		// Init() runs there is no side to move, and every move is rejected.
		GameRunner.Init();
	}
}
